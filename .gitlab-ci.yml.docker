variables:
  SCHEDULER_PARAMETERS: "-n 1 -p nitrogen"
  USER: legit
  VIBRA_HOME: $CI_BUILDS_DIR/$CI_PROJECT_PATH
  GIT_SUBMODULE_STRATEGY: recursive
  #GIT_SUBMODULE_FORCE_HTTPS: "true"
  #GIT_SUBMODULE_PATHS: src/_VibTools


stages:
    - update
    - build
    - unittest
    - quality
    - autodoc
    - deploy
    - cleanup

before_script:
        - hostname

######################
#### IMAGE BUILDS #########################################################
######################

update-submodule:
    tags:
       - local
       - shell
    stage: build
    script:
       - git submodule update --remote

build-docker-test-image:
    tags:
       - local
       - shell
    stage: build
    needs: [update-submodule]
    script:
       - git submodule update --remote
       - docker build --no-cache -t vib_unittest -f Dockerfile . 

build-docker-autodoc-image:
    tags:
       - local
       - shell
    stage: build
    needs: [update-submodule]
    script:
       - docker build --no-cache -t vib_sphinxdoc -f doc/Dockerfile.sphinx_doc .

###################
#### UNITTESTS ###########################################################
###################

##### VibTools #####
unittests-VibTools:
    tags:
        - local
        - shell
    stage: unittest
    needs: [build-docker-test-image]
    script:
        - docker run --workdir /app/src/_VibTools/tests vib_unittest pytest -v


#### Vibrations #####

unittest-Grid-Pawel:
    tags:
        - local
        - shell
    stage: unittest
    needs: [build-docker-test-image,unittests-VibTools]
    script:
        - docker run --workdir /app/unittests vib_unittest pytest -v test_Grids_unittest.py


unittest-Surface-Pawel:
    tags:
        - local
        - shell
    stage: unittest
    needs: [build-docker-test-image,unittests-VibTools]
    script:
        - docker run --workdir /app/unittests vib_unittest pytest -v test_Surfaces_unittest.py


unittest-Grids:
    tags:
        - local
        - shell
    stage: unittest
    needs: [build-docker-test-image,unittests-VibTools]
    script:
        - docker run --workdir /app/unittests vib_unittest pytest -v test_Grids.py


unittest-Surface:
    tags:
        - local
        - shell
    stage: unittest
    needs: [build-docker-test-image,unittests-VibTools]
    script:
        - docker run --workdir /app/unittests vib_unittest pytest -v test_Surface.py


unittest-Wavefunctions:
    tags:
        - local
        - shell
    stage: unittest
    needs: [build-docker-test-image]
    script:
        - docker run --workdir /app/unittests vib_unittest pytest -v test_Wavefunction.py


unittest-VSCF:
    tags:
        - local
        - shell
    stage: unittest
    needs: [build-docker-test-image]
    script:
        - docker run --workdir /app/unittests vib_unittest pytest -v test_VSCF.py


unittest-VCI:
    tags:
        - local
        - shell
    stage: unittest
    needs: [build-docker-test-image,unittests-VibTools]
    script:
        - docker run --workdir /app/unittests vib_unittest pytest -v test_VCI.py


unittest-Misc:
    tags:
        - local
        - shell
    stage: unittest
    needs: [build-docker-test-image]
    script:
        - docker run --workdir /app/unittests vib_unittest pytest -v test_Misc.py

################
# CODE QUALITY ####################################################################
################

unittest-Coverage:
    tags:
        - local
        - shell
    stage: quality
    needs:
        - build-docker-test-image
    script:
        - docker run --workdir /app/unittests --name vib_test_coverage vib_unittest pytest --cov=Vibrations --cov-report term --cov-report xml:coverage.xml
        - docker cp vib_test_coverage:/app/unittests/coverage.xml coverage.xml
    coverage: '/(?i)total.*? (100(?:\.0+)?\%|[1-9]?\d(?:\.\d+)?\%)$/'
    artifacts:
      reports:
        coverage_report:
          coverage_format: cobertura
          path: coverage.xml

unittest-Report:
    tags:
        - local
        - shell
    stage: quality
    needs: [build-docker-test-image]
    script:
        - docker run --workdir /app/unittests --name vib_test_report vib_unittest pytest --junitxml=report.xml
        - docker cp vib_test_report:/app/unittests/report.xml report.xml
    artifacts:
      when: always
      reports:
        junit: report.xml

unittest-Min-Coverage:
    tags:
        - local
        - shell
    stage: quality
    needs: [build-docker-test-image]
    script:
        - docker run --workdir /app/unittests vib_unittest pytest --cov=Vibrations --cov-fail-under=56


docstr-Min-Coverage:
    tags:
        - local
        - shell
    stage: quality
    needs:
        - build-docker-test-image
    script:
        - docker run --workdir /app/src --name vib_docstr vib_unittest docstr-coverage --fail-under=88 -b . Vibrations
        - docker cp vib_docstr:/app/src/docstr_coverage_badge.svg docstr_coverage_badge.svg
    artifacts:
      paths:
        - docstr_coverage_badge.svg

Style-Check-Min:
    tags:
        - local
        - shell
    stage: quality
    needs: [build-docker-test-image]
    script:
        - docker run --workdir /app/src vib_unittest pylint --fail-under=8.1 Vibrations


#######################
#### INTEGRATIONTEST ###########################################################
#######################

integrationtest-Vibrations:
    tags:
        - local
        - shell
    stage: unittest
    needs: [build-docker-test-image]
    script:
        - docker run --workdir /app/tests vib_unittest python tests.py

#######################
#### DOCUMENTATION #############################################################
#######################

build-sphinx-doc:
    tags:
        - local
        - shell
    stage: autodoc
    needs: [build-docker-autodoc-image ]
    script:
        - docker run --workdir /app/doc --name sphinxdoc_vib_container vib_sphinxdoc sphinx-build . build


pages:
    tags:
        - local
        - shell
    stage: deploy
    needs: [build-sphinx-doc]
    script:
        - docker cp sphinxdoc_vib_container:/app/doc/build/. public/
    artifacts:
        paths:
         - public


################################################
#alternative installation/environment via Conda#
################################################

build-docker-conda-test-image:
    tags:
       - local
       - shell
    stage: build
    needs: [update-submodule]
    script:
       - docker build --no-cache -t vib_condock -f unittests/Dockerfile.Conda .


unittest-Conda-Env-all_tests:
    tags:
        - local
        - shell
    stage: unittest
    needs:
        - build-docker-conda-test-image
    script:
        - docker run --workdir /app/unittests vib_condock conda run -n VibENV pytest -v


##################
#### CLEAN UP ##################################################################
##################

cleanup-docker:
    stage: cleanup
    tags: [local, shell]
    needs:
        - build-docker-test-image
        - unittest-Grid-Pawel
        - unittest-Surface-Pawel
        - unittest-Grids
        - unittest-Surface
        - unittest-Wavefunctions
        - unittest-VSCF
        - unittest-VCI
        - unittest-Misc
        - build-docker-autodoc-image
        - build-sphinx-doc
        - pages
        - build-docker-conda-test-image
        - unittest-Conda-Env-all_tests
        - unittests-VibTools
        - integrationtest-Vibrations
        - unittest-Coverage
    script:
        - docker rmi -f vib_unittest:latest
        - docker rmi -f vib_sphinxdoc:latest
        - docker rmi -f vib_condock
        - docker rm $(docker ps --filter status=exited -q)
        - docker system df
    when: always 
